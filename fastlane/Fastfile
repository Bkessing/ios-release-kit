# ios-release-kit — shared App Store release lanes.
#
# Consumed by an app's own Fastfile:
#
#   opt_out_usage
#   default_platform(:ios)
#   ENV["IRK_APP_ID"]  ||= "com.acme.app"
#   ENV["IRK_PROJECT"] ||= "Acme.xcodeproj"
#   ENV["IRK_SCHEME"]  ||= "Acme"
#   ENV["IRK_TEAM_ID"] ||= "XXXXXXXXXX"
#   import_from_git(url: "https://github.com/Bkessing/ios-release-kit")
#
# Auth is an App Store Connect API key, env-driven via the app's fastlane/.env:
#   ASC_KEY_ID, ASC_ISSUER_ID, optionally ASC_KEY_FILEPATH
#   (defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8)
#
# Every lane here was extracted from three shipped apps. The comments explaining
# WHY a lane is shaped the way it is are the point — each one encodes a specific
# failure that cost real days.

opt_out_usage
default_platform(:ios)

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

# Read config from the environment rather than Ruby constants. `import_from_git`
# evaluates this file in its own context, so constants defined in the consuming
# Fastfile are not reliably visible here; ENV always is.
def irk(key, required: true, default: nil)
  value = ENV["IRK_#{key}"] || default
  if required && value.to_s.strip.empty?
    UI.user_error!(
      "IRK_#{key} is not set. Add it to your Fastfile before import_from_git:\n" \
      "  ENV[\"IRK_#{key}\"] ||= \"...\""
    )
  end
  value
end

def app_id
  irk("APP_ID")
end
def project
  irk("PROJECT")
end
def scheme
  irk("SCHEME")
end
def team_id
  irk("TEAM_ID")
end
def app_name
  irk("APP_NAME", required: false, default: scheme)
end
def export_profile
  irk("EXPORT_PROFILE", required: false)
end

# Review contact. Apple requires these on submission; there is no sane default.
def contact_first
  irk("CONTACT_FIRST", required: false)
end
def contact_last
  irk("CONTACT_LAST",  required: false)
end
def contact_email
  irk("CONTACT_EMAIL", required: false)
end
def contact_phone
  irk("CONTACT_PHONE", required: false)
end

def key_path
  ENV["ASC_KEY_FILEPATH"] ||
    File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
end

def api_key
  UI.user_error!("API key not found at #{key_path} — check fastlane/.env") unless File.exist?(key_path)
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path
  )
end

def connect!
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: key_path
  )
end

def signing_xcargs
  # gym injects the API-key auth flags itself from app_store_connect_api_key.
  # Passing them again makes xcodebuild fail with
  # "-authenticationKeyID may only be provided once".
  base = "-allowProvisioningUpdates"
  profile = export_profile
  return base if profile.to_s.strip.empty?

  # ARCHIVE with manual signing too, not just export.
  #
  # Automatic signing at the archive step resolves to the team's wildcard
  # profile ("iOS Team Provisioning Profile: *"), which carries no
  # capabilities. That is invisible until an app declares one -- Game Center,
  # push, iCloud, HealthKit -- and then the archive fails with the pair:
  #
  #   No Accounts: Add a new account in Accounts settings.
  #   Provisioning profile "iOS Team Provisioning Profile: *" doesn't include
  #   the Game Center capability.
  #
  # which reads as a missing Apple ID and is really a wildcard profile being
  # asked to do a job it cannot. The correct profile is already named for the
  # export step; naming it for the archive too is the whole fix.
  [
    base,
    "CODE_SIGN_STYLE=Manual",
    "CODE_SIGN_IDENTITY=Apple Distribution",
    "DEVELOPMENT_TEAM=#{team_id}",
    "PROVISIONING_PROFILE_SPECIFIER='#{profile}'"
  ].join(" ")
end

# Export with MANUAL signing and a named profile.
#
# Automatic signing at the export step requires an Apple ID signed into Xcode.
# A headless or agent-driven run has none, and it fails as:
#
#     exportArchive No Accounts
#     exportArchive No profiles for '<bundle>' were found
#
# The second line is a lie by omission — the profile is not missing, automatic
# signing simply cannot authenticate to resolve one. Naming it removes both the
# lookup and the account dependency.
def export_options
  profile = export_profile
  return nil if profile.to_s.strip.empty?
  {
    signingStyle: "manual",
    teamID: team_id,
    signingCertificate: "Apple Distribution",
    provisioningProfiles: { app_id => profile }
  }
end

def timestamp_build
  Time.now.strftime("%Y%m%d%H%M")
end

# Raw App Store Connect request.
#
# Spaceship's request clients are pinned to the v1 base path, and two of the
# resources below only exist under v2. Rather than fight that, sign a request by
# hand with the same token Spaceship already holds. `path` must include the
# version segment (e.g. "/v2/appAvailabilities").
def asc_http(method, path, body = nil)
  require "net/http"
  require "json"
  connect!
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch,
            delete: Net::HTTP::Delete }.fetch(method)
  req = klass.new(uri)
  req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  req["Content-Type"] = "application/json"
  req.body = JSON.generate(body) if body
  res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
  unless res.code.to_i.between?(200, 299)
    UI.user_error!("ASC #{method.to_s.upcase} #{path} -> #{res.code}\n#{res.body}")
  end
  # Not every ASC endpoint answers JSON -- offer-code values come back as CSV --
  # and a parse error there would read as an API failure rather than a format
  # surprise. Hand back the raw string when it is not JSON.
  return {} if res.body.to_s.empty?
  begin
    JSON.parse(res.body)
  rescue JSON::ParserError
    res.body
  end
end

platform :ios do

  # -------------------------------------------------------------------------
  # Connection + account
  # -------------------------------------------------------------------------

  desc "Prove the App Store Connect connection by listing the team's apps."
  lane :verify do
    connect!
    apps = Spaceship::ConnectAPI::App.all
    UI.success("Connected. #{apps.count} app(s) on this team:")
    apps.each { |a| UI.message("  #{a.id}  #{a.name}  #{a.bundle_id}") }

    # Print IRK_TEAM_ID too, because it is the one config value the API key does
    # not carry and a first-timer would otherwise have to go hunting for it in
    # the developer portal. Every signing identity embeds it as the OU of its
    # certificate, so read it off the machine rather than sending them looking.
    ids = `security find-identity -v -p codesigning 2>/dev/null`
    found = ids.scan(/"((?:[^"]*?) \(([A-Z0-9]{10})\))"/).map { |full, id| [id, full] }.uniq(&:first)
    if found.empty?
      UI.important("Team ID: no signing identity on this Mac yet — run signing_cert, " \
                   "or read it from developer.apple.com > Membership details.")
    elsif found.one?
      UI.message("  Team ID: #{found.first[0]}   <- IRK_TEAM_ID")
    else
      # More than one Apple account has signed on this Mac. Guessing would set up
      # a build that fails much later with a confusing profile error, so name
      # them and let the human pick.
      UI.important("More than one team on this Mac. IRK_TEAM_ID is the one that owns the app:")
      found.each { |id, name| UI.message("  #{id}   #{name}") }
    end
  end

  desc "Register the bundle id, and report whether the app record exists."
  lane :create_app do
    connect!
    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == app_id }
    if bundle.nil?
      Spaceship::ConnectAPI::BundleId.create(
        name: app_name.gsub(/[^0-9A-Za-z ]/, "").strip, identifier: app_id, platform: "IOS"
      )
      UI.success("Registered bundle id #{app_id}")
    else
      UI.message("Bundle id #{app_id} already registered")
    end

    # Apple's API has no CREATE on the apps resource, so the app record itself
    # is the one irreducibly manual step in the whole pipeline.
    existing = (Spaceship::ConnectAPI::App.find(app_id) rescue nil)
    if existing
      UI.success("App exists: #{existing.name} (#{app_id})")
    else
      UI.important("Bundle id registered, but the app record must be created once by hand:")
      UI.message("  https://appstoreconnect.apple.com/apps -> + -> New App")
      UI.message("  Bundle ID: #{app_id}  Name: #{app_name}")
    end
  end

  desc "Create the Apple Distribution certificate if the account has none."
  # Release export needs a DISTRIBUTION identity. Accounts lose them — revoked
  # by a teammate, cleared by tooling, or simply never created on this Mac.
  # A missing one reports as "exportArchive No Accounts", which reads like an
  # Xcode sign-in problem and sends you looking in the wrong place entirely.
  lane :signing_cert do
    cert(api_key: api_key, development: false, output_path: "/tmp/#{scheme}-certs")
    UI.success("Distribution certificate ready.")
  end

  # -------------------------------------------------------------------------
  # Build + upload
  # -------------------------------------------------------------------------

  desc "Build a signed release and upload to TestFlight (internal testers only)."
  lane :beta_internal do
    key = api_key
    # xcodegen-managed projects do not commit the .xcodeproj, so regenerate it
    # before building or you build whatever stale file happens to be on disk.
    sh("cd .. && xcodegen generate") if irk("USES_XCODEGEN", required: false).to_s == "true"
    build_number = timestamp_build
    gym(
      project: project,
      scheme: scheme,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "/tmp/#{scheme.downcase}-fastlane",
      # Outside any iCloud-synced directory: codesign chokes on the extended
      # attributes iCloud adds to files under ~/Documents.
      derived_data_path: "/tmp/#{scheme.downcase}-dd-release",
      xcargs: "#{signing_xcargs} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: signing_xcargs,
      export_options: export_options
    )
    # No distribute_external: no Beta App Review, no ~24h wait. Internal testers
    # receive every uploaded build once processing finishes.
    pilot(
      api_key: key,
      app_identifier: app_id,
      distribute_external: false,
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "Internal build."
    )
    UI.success("Uploaded build #{build_number} to TestFlight (internal).")
  end

  desc "Distribute an already-uploaded build to external testers."
  lane :public_beta do
    UI.user_error!("Set IRK_CONTACT_PHONE (Apple requires a review contact phone)") if contact_phone.to_s.empty?
    pilot(
      api_key: api_key,
      app_identifier: app_id,
      distribute_external: true,
      distribute_only: true,   # distribute what is already uploaded; do not rebuild
      groups: (ENV["IRK_EXTERNAL_GROUPS"] || "Public Beta").split(","),
      notify_external_testers: true,
      changelog: ENV["CHANGELOG"] || "New build.",
      beta_app_review_info: {
        contact_first_name: contact_first,
        contact_last_name: contact_last,
        contact_email: contact_email,
        contact_phone: contact_phone,
        demo_account_required: false
      }
    )
  end

  # -------------------------------------------------------------------------
  # Version + submission
  # -------------------------------------------------------------------------

  desc "Create (or reuse) an editable App Store version and set What's New. VERSION= WHATS_NEW="
  lane :new_version do
    api_key
    version = ENV["VERSION"] or UI.user_error!("Set VERSION=1.2.3")
    whats_new = ENV["WHATS_NEW"] || "Bug fixes and improvements."
    app = Spaceship::ConnectAPI::App.find(app_id)

    v = app.get_edit_app_store_version
    if v.nil?
      v = Spaceship::ConnectAPI.post_app_store_version(
        app_id: app.id, attributes: { versionString: version, platform: "IOS" }
      ).to_models.first
      UI.success("Created version #{v.version_string}")
    else
      UI.important("Editable version already exists: #{v.version_string} (#{v.app_store_state}) — reusing")
    end

    locs = v.get_app_store_version_localizations
    en = locs.find { |l| l.locale == "en-US" } || locs.first
    if en
      en.update(attributes: { whatsNew: whats_new })
    else
      Spaceship::ConnectAPI.post_app_store_version_localization(
        app_store_version_id: v.id, attributes: { locale: "en-US", whatsNew: whats_new }
      )
    end
    UI.success("new_version done: #{v.version_string} (#{v.app_store_state})")
  end

  desc "Attach an uploaded build to the editable version. BUILD=<build number>"
  lane :attach_build do
    api_key
    build_number = ENV["BUILD"] or UI.user_error!("Set BUILD=<build number>")
    app = Spaceship::ConnectAPI::App.find(app_id)
    v = app.get_edit_app_store_version or UI.user_error!("No editable version — run new_version first")
    build = app.get_builds(filter: { version: build_number }).first
    UI.user_error!("Build #{build_number} not found") if build.nil?
    v.select_build(build_id: build.id)
    UI.success("Attached build #{build_number} to version #{v.version_string}")
  end

  desc "Set release type. RELEASE_TYPE=AFTER_APPROVAL|MANUAL|SCHEDULED"
  lane :set_release_type do
    api_key
    rt = ENV["RELEASE_TYPE"] || "AFTER_APPROVAL"
    app = Spaceship::ConnectAPI::App.find(app_id)
    v = app.get_edit_app_store_version ||
        app.get_app_store_versions.find { |x|
          %w[PREPARE_FOR_SUBMISSION WAITING_FOR_REVIEW IN_REVIEW PENDING_DEVELOPER_RELEASE]
            .include?(x.app_store_state)
        }
    UI.user_error!("No pending version found") if v.nil?
    Spaceship::ConnectAPI.patch_app_store_version(
      app_store_version_id: v.id, attributes: { releaseType: rt }
    )
    UI.success("releaseType=#{rt} on #{v.version_string}")
  end

  desc "Submit the editable version for review."
  lane :submit do
    key = api_key
    deliver(
      api_key: key,
      app_identifier: app_id,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false
    )
    app = Spaceship::ConnectAPI::App.find(app_id)
    v = app.get_app_store_versions.first
    UI.success("Submitted #{v&.version_string} — state #{v&.app_store_state}")
  end

  desc "Cancel a stuck submission and resubmit with a fresh build. BUILD=<build number>"
  # Cancelling does not release the version immediately: Apple takes time to
  # move it out of the review queue, and attaching during that window fails.
  # Retry rather than assuming the first attempt works.
  lane :resubmit do
    api_key
    build_number = ENV["BUILD"] or UI.user_error!("Set BUILD=<build number>")
    app = Spaceship::ConnectAPI::App.find(app_id)

    submission = app.get_review_submissions(filter: { state: "WAITING_FOR_REVIEW,IN_REVIEW" }).first
    if submission
      submission.cancel_submission
      UI.important("Cancelled submission #{submission.id}; waiting for the version to free up")
    end

    v = nil
    6.times do |attempt|
      v = app.get_edit_app_store_version
      break if v
      UI.message("  version not editable yet (attempt #{attempt + 1}/6)")
      sleep(10)
    end
    UI.user_error!("Version never became editable after cancelling") if v.nil?

    build = app.get_builds(filter: { version: build_number }).first
    UI.user_error!("Build #{build_number} not found") if build.nil?
    v.select_build(build_id: build.id)
    UI.success("Reattached build #{build_number}. Run `submit` when ready.")
  end

  # -------------------------------------------------------------------------
  # Assets + metadata
  # -------------------------------------------------------------------------

  desc "Unstick a REJECTED version whose old submission never resolved."
  # Replying in Resolution Center does NOT resubmit. The submission stays in
  # UNRESOLVED_ISSUES and keeps hold of the version, so every resubmit fails
  # with STATE_ERROR reported against the VERSION -- "Version is not ready to be
  # submitted yet, please try again later" -- which sends you looking at the
  # version, the build, the metadata, anywhere but the real cause. Lab Tycoon
  # sat in that state for 18 days.
  #
  # The existing `resubmit` lane is for a submission stuck in the review QUEUE.
  # This one is for a submission that came back rejected and was never cleared.
  #
  # Attached IAPs stuck in IN_REVIEW cannot be withdrawn from the API or the
  # dashboard. They free themselves to READY_TO_SUBMIT when the parent
  # submission is cancelled -- and that is the trap. Freeing them DETACHES them.
  # Unless they are re-attached here, the replacement submission carries the
  # version alone, review never sees the products, and the app is approved
  # without them. It then goes on sale able to take no money, and nothing
  # anywhere reports a problem: the listing is live and downloads arrive.
  #
  # Lab Tycoon shipped exactly this way on 2026-08-06. The rejected 07-18
  # submission had three items (version + two IAPs); the replacement built on
  # 08-04 had one, and was approved.
  lane :resubmit_rejected do
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)

    version = asc_http(:get, "/v1/apps/#{app.id}/appStoreVersions?limit=1&filter[platform]=IOS")["data"].first
    UI.user_error!("No version found") if version.nil?
    state = version.dig("attributes", "appStoreState")
    UI.message("version #{version.dig('attributes', 'versionString')} is #{state}")

    subs = asc_http(:get, "/v1/reviewSubmissions?filter[app]=#{app.id}&filter[platform]=IOS&limit=10")["data"]
    stuck = subs.select { |s| s.dig("attributes", "state") == "UNRESOLVED_ISSUES" }
    if stuck.empty?
      UI.success("No submission is stuck. Use `submit` instead.")
      next
    end
    UI.important("#{stuck.count} stuck submission(s) holding the version")

    # Create the replacement FIRST. If cancelling fails halfway there is still
    # somewhere to attach the version, rather than a version owned by nothing.
    fresh = asc_http(:post, "/v1/reviewSubmissions", {
      "data" => { "type" => "reviewSubmissions", "attributes" => { "platform" => "IOS" },
                  "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app.id.to_s } } } }
    })["data"]
    UI.message("created submission #{fresh['id']}")

    stuck.each do |s|
      asc_http(:patch, "/v1/reviewSubmissions/#{s['id']}",
               { "data" => { "type" => "reviewSubmissions", "id" => s["id"],
                             "attributes" => { "canceled" => true } } })
      UI.message("cancelled #{s['id']}")
    end

    # Cancelling is async. The version stays owned until it settles, so poll
    # rather than assuming one sleep is enough.
    attached = false
    8.times do |i|
      begin
        asc_http(:post, "/v1/reviewSubmissionItems", {
          "data" => { "type" => "reviewSubmissionItems", "relationships" => {
            "reviewSubmission" => { "data" => { "type" => "reviewSubmissions", "id" => fresh["id"] } },
            "appStoreVersion" => { "data" => { "type" => "appStoreVersions", "id" => version["id"] } } } }
        })
        attached = true
        break
      rescue FastlaneCore::Interface::FastlaneError
        UI.message("  version still held, retrying (#{i + 1}/8)")
        sleep(15)
      end
    end
    UI.user_error!("Version never came free. Re-run in a few minutes.") unless attached
    UI.success("version attached to #{fresh['id']}")

    # Report the products the cancellation freed. This CANNOT be automated here:
    # reviewSubmissionItems accepts only appStoreVersion, appEvent and
    # appCustomProductPageVersion, and POSTing an in-app purchase to it returns
    #   ENTITY_ERROR.RELATIONSHIP.UNKNOWN
    # while /v1/inAppPurchaseSubmissions refuses a freed product with
    #   ENTITY_ERROR.RELATIONSHIP.INVALID
    #   "InAppPurchase <id> has no pending version for submission"
    # because cancelling consumed the pending version the product had. The
    # product keeps its metadata and its READY_TO_SUBMIT state, so nothing looks
    # wrong; it simply has nothing left to submit until it is re-prepared in the
    # App Store Connect UI.
    #
    # So this is a loud warning, not a silent gap. Lab Tycoon was approved and
    # went on sale unable to take money precisely because nothing said this out
    # loud after the version went in without its products.
    freed = asc_http(:get, "/v1/apps/#{app.id}/inAppPurchasesV2?limit=200")["data"]
              .reject { |i| i.dig("attributes", "state") == "APPROVED" }
    unless freed.empty?
      UI.error("#{freed.count} in-app purchase(s) are NOT part of this submission:")
      freed.each { |i| UI.error("  #{i.dig('attributes', 'productId')}: #{i.dig('attributes', 'state')}") }
      UI.error("Attach each product's child inAppPurchaseVersion to THIS submission")
      UI.error("before PATCHing submitted=true: GET /v2/inAppPurchases/{id}/versions,")
      UI.error("then POST /v1/reviewSubmissionItems with relationship")
      UI.error("`inAppPurchaseVersion` -> type `inAppPurchaseVersions`.")
      UI.error("Verify afterwards with: appstore-doctor --bundle #{app_id}")
    end

    asc_http(:patch, "/v1/reviewSubmissions/#{fresh['id']}",
             { "data" => { "type" => "reviewSubmissions", "id" => fresh["id"],
                           "attributes" => { "submitted" => true } } })
    final = asc_http(:get, "/v1/reviewSubmissions/#{fresh['id']}").dig("data", "attributes", "state")
    UI.success("submitted. state=#{final}")
    UI.important("Review notes are NOT changed by this lane. If the rejection was") 
    UI.important("about something a reviewer could not find, fix the notes first.")
  end

  desc "List subscription offer codes and how long each batch has left."
  # Gift codes expire, and nothing warns you. CardHabit's creator-seeding play
  # ran on a batch expiring 2026-08-15 while the one creator who converted took
  # 18 DAYS between the email and signing up -- so codes sent in the final
  # fortnight were dead on arrival and nobody would ever have reported it.
  lane :offer_codes do
    require "date"
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    today = Date.today
    asc_http(:get, "/v1/apps/#{app.id}/subscriptionGroups?limit=10")["data"].each do |g|
      asc_http(:get, "/v1/subscriptionGroups/#{g['id']}/subscriptions?limit=20")["data"].each do |s|
        pid = s.dig("attributes", "productId")
        asc_http(:get, "/v1/subscriptions/#{s['id']}/offerCodes?limit=20")["data"].each do |oc|
          a = oc["attributes"]
          UI.message("#{pid} — offer '#{a['name']}' (#{a['duration']} x#{a['numberOfPeriods']}) active=#{a['active']}")
          UI.message("  id #{oc['id']}")
          asc_http(:get, "/v1/subscriptionOfferCodes/#{oc['id']}/oneTimeUseCodes?limit=20")["data"].each do |b|
            ba = b["attributes"]
            exp = Date.parse(ba["expirationDate"]) rescue nil
            days = exp ? (exp - today).to_i : nil
            note = if !ba["active"] then "INACTIVE"
                   elsif days.nil? then ""
                   elsif days <= 0 then "EXPIRED"
                   elsif days <= 21 then "EXPIRES IN #{days}d — shorter than the 18-day lag seen on the one conversion"
                   else "#{days}d left"
                   end
            line = "  batch #{b['id'][0, 8]}  #{ba['numberOfCodes']} codes  expires #{ba['expirationDate']}  #{note}"
            days && days <= 21 && ba["active"] ? UI.important(line) : UI.message(line)
          end
        end
      end
    end
  end

  desc "Mint a fresh one-time offer-code batch. OFFER_CODE_ID= COUNT=500 EXPIRES=YYYY-MM-DD OUT=<path>"
  # Apple's minimum batch is 500; 25 and 100 are both rejected as "invalid
  # number of codes". Expiration must be a future date and Apple caps it at six
  # months out.
  #
  # The codes themselves come back as CSV from a DIFFERENT endpoint than the one
  # that creates the batch, and they are the deliverable -- creating a batch you
  # never download is useless. Written outside any repo by default.
  lane :new_offer_codes do
    require "date"
    connect!
    offer_id = ENV["OFFER_CODE_ID"] or UI.user_error!("Set OFFER_CODE_ID= (run `offer_codes` to find it)")
    count    = (ENV["COUNT"] || "500").to_i
    expires  = ENV["EXPIRES"] or UI.user_error!("Set EXPIRES=YYYY-MM-DD")
    out      = ENV["OUT"] || File.expand_path("~/Downloads/offer-codes-#{expires}.csv")

    UI.user_error!("Apple's minimum batch is 500") if count < 500
    exp = Date.parse(expires)
    UI.user_error!("EXPIRES must be in the future") if exp <= Date.today
    UI.user_error!("Apple caps expiration at six months out") if exp > Date.today + 183

    batch = asc_http(:post, "/v1/subscriptionOfferCodeOneTimeUseCodes", {
      "data" => { "type" => "subscriptionOfferCodeOneTimeUseCodes",
                  "attributes" => { "numberOfCodes" => count, "expirationDate" => expires },
                  "relationships" => { "offerCode" => { "data" => {
                    "type" => "subscriptionOfferCodes", "id" => offer_id } } } }
    })["data"]
    UI.success("created batch #{batch['id']} — #{count} codes, expires #{expires}")

    csv = asc_http(:get, "/v1/subscriptionOfferCodeOneTimeUseCodes/#{batch['id']}/values")
    if csv.is_a?(String) && !csv.strip.empty?
      File.write(out, csv)
      UI.success("wrote #{csv.lines.count - 1} codes to #{out}")
    else
      UI.important("Batch created but the values endpoint returned nothing yet.")
      UI.important("Apple generates them asynchronously; re-fetch in a minute:")
      UI.important("  /v1/subscriptionOfferCodeOneTimeUseCodes/#{batch['id']}/values")
    end
  end

  desc "Submit the editable version AND its unapproved in-app purchases together. DRY=1 to preview."
  # The only way to get a FIRST consumable or FIRST non-consumable approved:
  # one reviewSubmission carrying the app version and every product, with all
  # items attached BEFORE submitted=true. Submitting the version alone is how
  # Lab Tycoon went on sale unable to take money.
  #
  # The relationship is `inAppPurchaseVersion` -> type `inAppPurchaseVersions`,
  # using the product's CHILD version id from GET /v2/inAppPurchases/{id}/versions.
  # reviewSubmissionItems has no `inAppPurchaseV2` relationship; posting one
  # returns 409 ENTITY_ERROR.RELATIONSHIP.UNKNOWN. Products whose child version
  # is DEVELOPER_REJECTED (what cancelling a submission leaves behind) get a
  # fresh one via POST /v1/inAppPurchaseVersions.
  lane :submit_with_iaps do
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    dry = !ENV["DRY"].to_s.empty?

    version = asc_http(:get, "/v1/apps/#{app.id}/appStoreVersions?limit=10&filter[platform]=IOS")["data"]
                # READY_FOR_REVIEW belongs here: attaching a version to a
                # submission moves it out of PREPARE_FOR_SUBMISSION before
                # anything is submitted, so a lane that only looks for editable
                # states cannot finish the job it started on its own re-run.
                .find { |v| %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED READY_FOR_REVIEW]
                              .include?(v.dig("attributes", "appStoreState")) }
    UI.user_error!("No editable version. Run new_version first.") if version.nil?
    UI.message("version #{version.dig('attributes', 'versionString')} (#{version.dig('attributes', 'appStoreState')})")

    iaps = asc_http(:get, "/v1/apps/#{app.id}/inAppPurchasesV2?limit=200")["data"]
             .reject { |i| i.dig("attributes", "state") == "APPROVED" }
    iaps.each { |i| UI.message("  #{i.dig('attributes', 'productId')}: #{i.dig('attributes', 'state')}") }

    skip = iaps.select { |i| i.dig("attributes", "state") == "MISSING_METADATA" }
    skip.each { |i| UI.important("skipping #{i.dig('attributes', 'productId')} — MISSING_METADATA would sink the version with it") }
    iaps -= skip

    if dry
      UI.important("DRY=1 — would submit the version plus #{iaps.count} product(s)")
      next
    end

    # An itemless READY_FOR_REVIEW submission is reused rather than orphaned;
    # opening a second one while it exists earns ITEM_PART_OF_ANOTHER_SUBMISSION.
    # Reuse ANY unsubmitted submission, not just an itemless one. A partially
    # built submission is exactly what a failed run leaves behind, and opening a
    # second one then fails with ITEM_PART_OF_ANOTHER_SUBMISSION -- reported
    # against the version, which sends you looking at the version instead of at
    # the leftover. Re-running this lane has to converge.
    existing = asc_http(:get, "/v1/reviewSubmissions?filter[app]=#{app.id}&filter[platform]=IOS&limit=20")["data"]
                 .find { |s| s.dig("attributes", "state") == "READY_FOR_REVIEW" }

    sub = existing || asc_http(:post, "/v1/reviewSubmissions", {
      "data" => { "type" => "reviewSubmissions", "attributes" => { "platform" => "IOS" },
                  "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app.id.to_s } } } }
    })["data"]
    UI.message(existing ? "reusing submission #{sub['id']}" : "created submission #{sub['id']}")

    already = asc_http(:get, "/v1/reviewSubmissions/#{sub['id']}/items?limit=50&include=appStoreVersion")["data"]
    have_version = already.any? { |it| it.dig("relationships", "appStoreVersion", "data") }

    if have_version
      UI.message("version already attached")
    else
      # Cancelling a previous submission releases the version asynchronously, so
      # the first attach can fail purely on timing.
      attached = false
      6.times do |i|
        begin
          asc_http(:post, "/v1/reviewSubmissionItems", {
            "data" => { "type" => "reviewSubmissionItems", "relationships" => {
              "reviewSubmission" => { "data" => { "type" => "reviewSubmissions", "id" => sub["id"] } },
              "appStoreVersion" => { "data" => { "type" => "appStoreVersions", "id" => version["id"] } } } }
          })
          attached = true
          break
        rescue FastlaneCore::Interface::FastlaneError
          UI.message("  version not free yet, retrying (#{i + 1}/6)")
          sleep(10)
        end
      end
      UI.user_error!("Version never came free.") unless attached
      UI.success("attached version")
    end

    iaps.each do |iap|
      pid  = iap.dig("attributes", "productId")
      vers = asc_http(:get, "/v2/inAppPurchases/#{iap['id']}/versions?limit=10")["data"]
      # DEVELOPER_REJECTED is NOT terminal, and NOT replaceable: that child is
      # still the product's inflight version, so trying to create a new one
      # earns STATE_ERROR.ALREADY_EXISTS naming the very id you were avoiding.
      # Attaching it to a fresh submission is what revives it. Only an empty
      # array means there is genuinely nothing to attach.
      live = vers.find { |v| v.dig("attributes", "state") != "DEVELOPER_REJECTED" } || vers.first
      if live.nil?
        # Note the asymmetry: reviewSubmissionItems links the CHILD via
        # `inAppPurchaseVersion`, but creating that child links the PARENT via
        # `inAppPurchase` -- not `inAppPurchaseV2`, which the API rejects here
        # even though that is the name on the app's own relationship.
        live = asc_http(:post, "/v1/inAppPurchaseVersions", {
          "data" => { "type" => "inAppPurchaseVersions", "relationships" => {
            "inAppPurchase" => { "data" => { "type" => "inAppPurchases", "id" => iap["id"] } } } }
        })["data"]
        UI.message("  created a fresh version for #{pid}")
      else
        UI.message("  using #{pid} version #{live['id']} (#{live.dig('attributes', 'state')})")
      end
      asc_http(:post, "/v1/reviewSubmissionItems", {
        "data" => { "type" => "reviewSubmissionItems", "relationships" => {
          "reviewSubmission" => { "data" => { "type" => "reviewSubmissions", "id" => sub["id"] } },
          "inAppPurchaseVersion" => { "data" => { "type" => "inAppPurchaseVersions", "id" => live["id"] } } } }
      })
      UI.success("attached #{pid}")
    end

    # Submitting an empty submission is a silent no-op that looks like success.
    items = asc_http(:get, "/v1/reviewSubmissions/#{sub['id']}/items?limit=50")["data"]
    UI.user_error!("Submission has no items — refusing to submit") if items.empty?
    UI.message("#{items.count} item(s) attached")

    asc_http(:patch, "/v1/reviewSubmissions/#{sub['id']}",
             { "data" => { "type" => "reviewSubmissions", "id" => sub["id"],
                           "attributes" => { "submitted" => true } } })

    state = asc_http(:get, "/v1/reviewSubmissions/#{sub['id']}").dig("data", "attributes", "state")
    UI.success("submitted. state=#{state}")
    # No flip to WAITING_FOR_REVIEW means not actually attached, which is the
    # 2.1(b) rejection waiting to happen.
    asc_http(:get, "/v1/apps/#{app.id}/inAppPurchasesV2?limit=200")["data"].each do |i|
      UI.message("  #{i.dig('attributes', 'productId')}: #{i.dig('attributes', 'state')}")
    end
  end

  desc "Report/submit unapproved in-app purchases on a LIVE app. DRY=1 to preview."
  #
  # KNOWN LIMIT: /v1/inAppPurchaseSubmissions only works for a product whose
  # TYPE has already had one product approved. The FIRST consumable and the
  # FIRST non-consumable must each be submitted WITH an app version instead.
  #
  # Two different errors come out of that, and neither says so:
  #   STATE_ERROR.FIRST_NON_CONSUMABLE_MUST_BE_SUBMITTED_ON_VERSION
  #   ENTITY_ERROR.RELATIONSHIP.INVALID
  #     "InAppPurchase <id> has no pending version for submission"
  # The second is the one you get after cancelling a submission the product was
  # attached to: that leaves its child inAppPurchaseVersion in
  # DEVELOPER_REJECTED, which is not "pending". Check with
  #   GET /v2/inAppPurchases/{id}/versions
  # The product itself still reads READY_TO_SUBMIT with complete metadata, so
  # nothing looks wrong at the level anyone inspects.
  #
  # The co-submit route is fully automatable and documented in the ASC ops
  # notes: attach the version AND each product to ONE reviewSubmission, using
  # relationship `inAppPurchaseVersion` -> type `inAppPurchaseVersions` with the
  # child version id (NOT `inAppPurchaseV2`, which does not exist on that
  # resource). Attach every item BEFORE PATCHing submitted=true. Since it needs
  # an app version to ride, a live app must carry its stranded products on the
  # next release rather than sending them alone.
  # Once an app is on sale, its IAPs are submitted on their own -- they do not
  # need a new binary and do not wait for a version. Nothing in App Store
  # Connect tells you they were left behind: the listing is live, downloads
  # arrive, and the app quietly takes no money.
  #
  # Lab Tycoon shipped 1.0 on 2026-08-06 with both products in READY_TO_SUBMIT
  # after the 2.1(b) fight, and appstore-doctor reported it as a PASS ("0 of 2
  # approved") because it only looked for trouble before submission. Run
  # `appstore-doctor --bundle <id>` after any release; it now FAILs on this.
  #
  # MISSING_METADATA products are skipped rather than submitted. They have no
  # display name, description or review screenshot, so submitting them earns a
  # rejection that also holds up the products that were ready. Complete them or
  # delete them; do not sweep them in here.
  lane :submit_iaps do
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    dry = !ENV["DRY"].to_s.empty?

    iaps = asc_http(:get, "/v1/apps/#{app.id}/inAppPurchasesV2?limit=200")["data"]
    ready = iaps.select { |i| i.dig("attributes", "state") == "READY_TO_SUBMIT" }
    blocked = iaps.select { |i| i.dig("attributes", "state") == "MISSING_METADATA" }

    iaps.each { |i| UI.message("  #{i.dig('attributes', 'productId')}: #{i.dig('attributes', 'state')}") }

    blocked.each do |i|
      UI.important("skipping #{i.dig('attributes', 'productId')} — MISSING_METADATA, would be rejected")
    end

    if ready.empty?
      UI.success("Nothing to submit. No product is in READY_TO_SUBMIT.")
      next
    end

    if dry
      UI.important("DRY=1 — would submit #{ready.count} product(s), no request sent")
      next
    end

    # An empty READY_FOR_REVIEW submission holds nothing but still occupies the
    # app, so the next version submission fails with
    # ITEM_PART_OF_ANOTHER_SUBMISSION and points at the version rather than at
    # this leftover. An earlier version of this lane created one on every run
    # before failing, so clear any that are sitting there with no items.
    #
    # This is hygiene, not the job, so it must never abort the run. A leftover
    # that was never submitted is not "cancellable" -- Apple answers
    # STATE_ERROR.ENTITY_STATE_INVALID, "Resource is not in cancellable state"
    # -- it is deleted. Try both and shrug if neither works.
    asc_http(:get, "/v1/reviewSubmissions?filter[app]=#{app.id}&filter[platform]=IOS&limit=20")["data"]
      .select { |s| s.dig("attributes", "state") == "READY_FOR_REVIEW" }
      .each do |s|
        next unless asc_http(:get, "/v1/reviewSubmissions/#{s['id']}/items?limit=5")["data"].empty?
        begin
          asc_http(:delete, "/v1/reviewSubmissions/#{s['id']}")
          UI.important("deleted empty submission #{s['id']}")
        rescue FastlaneCore::Interface::FastlaneError
          begin
            asc_http(:patch, "/v1/reviewSubmissions/#{s['id']}",
                     { "data" => { "type" => "reviewSubmissions", "id" => s["id"],
                                   "attributes" => { "canceled" => true } } })
            UI.important("cancelled empty submission #{s['id']}")
          rescue FastlaneCore::Interface::FastlaneError
            UI.important("left empty submission #{s['id']} in place (not deletable or cancellable)")
          end
        end
      end

    # An in-app purchase is NOT submitted through reviewSubmissions. The items
    # resource accepts only appStoreVersion, appEvent and
    # appCustomProductPageVersion; posting an IAP there returns
    #   ENTITY_ERROR.RELATIONSHIP.UNKNOWN
    #   'inAppPurchaseV2' is not a relationship on the resource
    #     'reviewSubmissionItems'
    # Products get their own resource, one submission per product, with no
    # separate "submit" step -- creating it IS submitting it.
    ready.each do |iap|
      pid = iap.dig("attributes", "productId")
      asc_http(:post, "/v1/inAppPurchaseSubmissions", {
        "data" => { "type" => "inAppPurchaseSubmissions", "relationships" => {
          "inAppPurchaseV2" => { "data" => { "type" => "inAppPurchases", "id" => iap["id"] } } } }
      })
      UI.success("submitted #{pid}")
    end

    after = asc_http(:get, "/v1/apps/#{app.id}/inAppPurchasesV2?limit=200")["data"]
    after.each { |i| UI.message("  #{i.dig('attributes', 'productId')}: #{i.dig('attributes', 'state')}") }
    UI.success("submitted #{ready.count} in-app purchase(s)")
  end

  desc "Replace BOTH iPhone screenshot sets. IRK_SHOTS_DIR=<dir with 65/ subdir>"
  # The previous version of this lane wrote only APP_IPHONE_65. That is the
  # SECONDARY set: APP_IPHONE_67 (6.9in) is what modern iPhones render in search
  # results, so updating one silently left the other serving stale artwork to
  # most traffic. Always write both, and fail loudly rather than half-updating.
  lane :upload_shots do
    api_key
    dir = irk("SHOTS_DIR")
    names = (ENV["IRK_SHOT_NAMES"] || "").split(",").map(&:strip).reject(&:empty?)
    names = Dir.glob(File.join(dir, "*.png")).sort.map { |f| File.basename(f) } if names.empty?
    UI.user_error!("No screenshots found in #{dir}") if names.empty?

    targets = {
      "APP_IPHONE_67" => [dir, "1290x2796"],
      "APP_IPHONE_65" => [File.join(dir, "65"), "1284x2778"],
    }

    app = Spaceship::ConnectAPI::App.find(app_id)
    v = app.get_edit_app_store_version or UI.user_error!("No editable version — run new_version first")
    loc = v.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    UI.user_error!("no en-US localization") if loc.nil?

    targets.each do |display_type, (src, expected)|
      files = names.map { |f| File.join(src, f) }
      next UI.important("skipping #{display_type}: #{src} not present") unless files.all? { |f| File.exist?(f) }

      files.each do |f|
        # PNG IHDR: width and height are big-endian uint32 at offsets 16 and 20.
        # Read them directly so the guard has no external dependency.
        w, h = File.binread(f, 8, 16).unpack("N2")
        UI.user_error!("#{File.basename(f)} is #{w}x#{h}, expected #{expected} for #{display_type}") if "#{w}x#{h}" != expected
      end

      set = loc.get_app_screenshot_sets.find { |x| x.screenshot_display_type == display_type }
      if set.nil?
        set = Spaceship::ConnectAPI.post_app_screenshot_set(
          app_store_version_localization_id: loc.id,
          attributes: { screenshotDisplayType: display_type }
        ).to_models.first
      else
        set.app_screenshots.each(&:delete!)
      end
      files.each { |f| set.upload_screenshot(path: f, wait_for_processing: true) }
      UI.success("#{display_type}: #{files.length} screenshots")
    end
  end

  desc "Pull the live ASC listing into fastlane/metadata/ as the source of truth."
  lane :pull_metadata do
    require "fileutils"
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    dir = File.expand_path("metadata/en-US", __dir__)
    FileUtils.mkdir_p(dir)

    info = (app.fetch_edit_app_info rescue nil) || (app.fetch_live_app_info rescue nil)
    info&.get_app_info_localizations&.each do |l|
      next unless l.locale == "en-US"
      File.write(File.join(dir, "name.txt"), l.name.to_s)
      File.write(File.join(dir, "subtitle.txt"), l.subtitle.to_s)
    end

    v = app.get_edit_app_store_version || app.get_live_app_store_version
    UI.user_error!("No App Store version found") if v.nil?
    v.get_app_store_version_localizations.each do |loc|
      next unless loc.locale == "en-US"
      {
        "description.txt" => loc.description, "keywords.txt" => loc.keywords,
        "promotional_text.txt" => loc.promotional_text, "release_notes.txt" => loc.whats_new,
        "support_url.txt" => loc.support_url, "marketing_url.txt" => loc.marketing_url
      }.each { |f, val| File.write(File.join(dir, f), val.to_s) }
    end
    UI.success("Wrote listing to fastlane/metadata/en-US/ — commit it.")
  end

  desc "Push fastlane/metadata/ to the editable version. Submits nothing."
  lane :push_metadata do
    deliver(
      api_key: api_key,
      app_identifier: app_id,
      metadata_path: "fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
    UI.success("Metadata pushed. Nothing submitted.")
  end

  # -------------------------------------------------------------------------
  # Status
  # -------------------------------------------------------------------------

  desc "Version states, attached build, and the current review submission."
  lane :release_status do
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    app.get_app_store_versions(limit: 5).each do |v|
      build = (v.get_build rescue nil)
      UI.message("  #{v.version_string.to_s.ljust(8)} #{v.app_store_state.to_s.ljust(26)} " \
                 "release=#{v.release_type} build=#{build&.version || '-'}")
    end
    app.get_review_submissions(limit: 3).each do |s|
      UI.message("  submission state=#{s.state} submitted=#{s.submitted_date}")
    end
  end

  desc "TestFlight groups, testers, and unexpired builds."
  lane :tf_state do
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    app.get_beta_groups.each do |g|
      UI.message("  GROUP '#{g.name}' internal=#{g.is_internal_group}")
    end
    builds = app.get_builds(limit: 10).reject(&:expired)
    UI.message("  #{builds.count} unexpired build(s): #{builds.map(&:version).join(', ')}")
  end

  desc "Create the internal TestFlight group and add a tester. TESTER_EMAIL= overrides IRK_CONTACT_EMAIL"
  lane :setup_internal do
    require "net/http"
    require "json"
    connect!
    token = Spaceship::ConnectAPI.token
    app = Spaceship::ConnectAPI::App.find(app_id)
    email = ENV["TESTER_EMAIL"] || contact_email
    UI.user_error!("Set TESTER_EMAIL or IRK_CONTACT_EMAIL") if email.to_s.empty?

    internal = app.get_beta_groups.find(&:is_internal_group)
    if internal.nil?
      # fastlane's create_beta_group always sends publicLinkLimit, which internal
      # groups reject outright, so POST a clean body ourselves.
      uri = URI("https://api.appstoreconnect.apple.com/v1/betaGroups")
      body = { data: { type: "betaGroups",
        attributes: { name: "Internal Testers", isInternalGroup: true, hasAccessToAllBuilds: true },
        relationships: { app: { data: { id: app.id, type: "apps" } } } } }
      req = Net::HTTP::Post.new(uri)
      req["Authorization"] = "Bearer #{token.text}"
      req["Content-Type"] = "application/json"
      req.body = body.to_json
      res = Net::HTTP.start(uri.host, 443, use_ssl: true) { |h| h.request(req) }
      UI.user_error!("Group create failed: #{res.code} #{res.body}") unless res.code.to_i.between?(200, 299)
      internal = Spaceship::ConnectAPI::App.find(app_id).get_beta_groups.find(&:is_internal_group)
      UI.success("Created internal group 'Internal Testers'")
    end

    tester = (internal.get_beta_testers.find { |t| t.email&.casecmp?(email) } rescue nil)
    if tester
      UI.success("#{email} is already an internal tester.")
    else
      Spaceship::ConnectAPI.post_beta_tester_assignment(
        beta_group_ids: [internal.id],
        attributes: { email: email, firstName: contact_first.to_s, lastName: contact_last.to_s }
      )
      UI.success("Added #{email} as an internal tester.")
    end
  end

  desc "Processing and TestFlight state of recent builds."
  lane :build_status do
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    builds = app.get_builds(includes: "preReleaseVersion,buildBetaDetail", limit: 5)
    UI.important("No builds visible yet for #{app_id}.") if builds.empty?
    builds.each do |b|
      d = b.build_beta_detail
      UI.message("build #{b.version}  processing=#{b.processing_state}  " \
                 "internal=#{d&.internal_build_state}  external=#{d&.external_build_state}")
    end
  end

  desc "Stage support URL + App Review contact details on the editable version."
  # Deliberately does NOT submit. Staging and submitting are separate lanes so a
  # metadata fix can never accidentally push a build into review.
  lane :stage do
    api_key
    UI.user_error!("Set IRK_CONTACT_PHONE (Apple requires a review contact phone)") if contact_phone.to_s.empty?
    app = Spaceship::ConnectAPI::App.find(app_id)
    v = app.get_edit_app_store_version
    UI.user_error!("No editable version") if v.nil?

    support_file = "fastlane/metadata/en-US/support_url.txt"
    if File.exist?(support_file)
      support = File.read(support_file).strip
      v.get_app_store_version_localizations.each { |loc| loc.update(attributes: { supportUrl: support }) }
    end

    notes_file = "fastlane/metadata/review_notes.txt"
    review_attrs = {
      contactFirstName: contact_first, contactLastName: contact_last,
      contactPhone: contact_phone, contactEmail: contact_email,
      demoAccountRequired: false,
      notes: (File.exist?(notes_file) ? File.read(notes_file) : "")
    }
    d = (v.fetch_app_store_review_detail rescue nil)
    d ? d.update(attributes: review_attrs) : v.create_app_store_review_detail(attributes: review_attrs)
    UI.success("Staged support URL and review info. Submission is a separate lane.")
  end

  desc "Set the privacy policy URL on every locale. URL= overrides IRK_PRIVACY_URL"
  # Separate from `stage` on purpose: the privacy policy lives on
  # appInfoLocalizations, NOT on the version localizations `stage` writes. They
  # are different resources on different parents, so a version that has been
  # fully staged can still be missing this, and Apple blocks submission on it.
  lane :set_privacy_policy do |options|
    url = (options[:url] || ENV["URL"] || irk("PRIVACY_URL", required: false)).to_s.strip
    UI.user_error!("Pass URL=https://... or set IRK_PRIVACY_URL") if url.empty?
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    info = asc_http(:get, "/v1/apps/#{app.id}/appInfos?limit=5")["data"].first
    UI.user_error!("No appInfo for #{app_id}") if info.nil?
    locs = asc_http(:get, "/v1/appInfos/#{info['id']}/appInfoLocalizations?limit=50")["data"]
    locs.each do |loc|
      current = loc["attributes"]["privacyPolicyUrl"].to_s.strip
      if current == url
        UI.message("#{loc['attributes']['locale']}: already #{url}")
        next
      end
      asc_http(:patch, "/v1/appInfoLocalizations/#{loc['id']}", {
        "data" => { "type" => "appInfoLocalizations", "id" => loc["id"],
                    "attributes" => { "privacyPolicyUrl" => url } }
      })
      UI.success("#{loc['attributes']['locale']}: set -> #{url}")
    end
  end

  desc "Make the app available in every App Store territory. Creates the record if absent."
  # The quietest landmine in the whole pipeline: an app can sit at
  # READY_FOR_SALE, fully approved, and be purchasable in ZERO storefronts
  # because this resource was never created. Nothing in App Store Connect warns
  # you; a 404 on appAvailabilityV2 is the only signal, which is exactly what
  # appstore-doctor's listing check looks for.
  #
  # Creation is all-or-nothing: there is no PATCH to add territories to an
  # existing record through this endpoint, so the lane refuses rather than
  # pretending it changed something.
  lane :open_territories do
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)

    existing = begin
      asc_http(:get, "/v1/apps/#{app.id}/appAvailabilityV2")
    rescue FastlaneCore::Interface::FastlaneError
      nil
    end
    if existing && existing["data"]
      # Follow Apple's OWN relationship link. The v1 path for this relationship
      # does not exist -- asking for it returns a PATH_ERROR that reads like the
      # app has no territories, when it has all of them.
      link = existing.dig("data", "relationships", "territoryAvailabilities", "links", "related")
      count = 0
      page = "#{link}?limit=200"
      while page
        body = asc_http(:get, page.sub("https://api.appstoreconnect.apple.com", ""))
        count += body["data"].count { |t| t["attributes"]["available"] }
        page = body.dig("links", "next")
      end
      UI.success("Availability already exists: #{count} territories. Nothing to do.")
      next
    end

    territories = []
    page = "/v1/territories?limit=200"
    while page
      body = asc_http(:get, page.sub("https://api.appstoreconnect.apple.com", ""))
      territories += body["data"].map { |t| t["id"] }
      page = body.dig("links", "next")
    end
    UI.message("Creating availability across #{territories.count} territories")

    asc_http(:post, "/v2/appAvailabilities", {
      "data" => {
        "type" => "appAvailabilities",
        "attributes" => { "availableInNewTerritories" => true },
        "relationships" => {
          "app" => { "data" => { "type" => "apps", "id" => app.id.to_s } },
          "territoryAvailabilities" => {
            "data" => territories.map { |id| { "type" => "territoryAvailabilities", "id" => id } }
          }
        }
      }
    })
    UI.success("Availability created across #{territories.count} territories.")
  end

  desc "Turn on App Store analytics reports. SNAPSHOT=1 backfills history instead of starting a feed."
  # Apple does NOT keep analytics waiting for you to ask. It generates reports
  # only for apps that have an analyticsReportRequest, and an app without one has
  # no impressions, no source types and no download reports -- not "empty", but
  # absent. You discover this the day you first want to know where an install
  # came from, which is the day it is already too late.
  #
  # That is exactly how it went: Lab Tycoon launched, took two organic installs
  # on day one, and had no request on the app, so Apple could not say whether
  # either came from search.
  #
  # Two access types, and the difference matters:
  #
  #   ONGOING           starts a daily feed FROM NOW. It cannot see the past.
  #   ONE_TIME_SNAPSHOT backfills up to a year of history, once.
  #
  # So a launch needs both: the snapshot to recover what already happened, the
  # feed to keep it coming. Run this the day the app record exists, not the day
  # you want a number.
  #
  # Reading the reports back is a GET, so it lives in appstore-doctor rather than
  # here. This lane only turns the tap on.
  lane :analytics_report do
    connect!
    app = Spaceship::ConnectAPI::App.find(app_id)
    # App.find returns nil for a bundle id this account does not own, and the
    # next line would die on `undefined method 'id' for nil` -- an error that
    # says nothing about the actual mistake, which is almost always a typo in
    # IRK_APP_ID. Name it instead.
    UI.user_error!("No app on this account with bundle id #{app_id}. Check IRK_APP_ID.") if app.nil?
    want = ENV["SNAPSHOT"] ? "ONE_TIME_SNAPSHOT" : "ONGOING"

    existing = asc_http(:get, "/v1/apps/#{app.id}/analyticsReportRequests?limit=50")["data"] || []
    existing.each do |r|
      a = r["attributes"]
      # Apple switches a feed off when nobody ever collects from it. The request
      # still exists and still reads as configured, so the only tell is this
      # flag, and a stopped feed looks exactly like a working one until you go
      # looking for a date range that is missing.
      state = a["stoppedDueToInactivity"] ? "STOPPED (inactivity)" : "active"
      UI.message("  existing: #{a['accessType']} #{state}  #{r['id']}")
    end

    live = existing.find { |r| r["attributes"]["accessType"] == want &&
                              !r["attributes"]["stoppedDueToInactivity"] }
    if live
      UI.success("#{want} request already active (#{live['id']}). Nothing to do.")
      next
    end

    made = asc_http(:post, "/v1/analyticsReportRequests", {
      "data" => {
        "type" => "analyticsReportRequests",
        "attributes" => { "accessType" => want },
        "relationships" => { "app" => { "data" => { "type" => "apps", "id" => app.id.to_s } } }
      }
    })
    UI.success("#{want} analytics request created: #{made.dig('data', 'id')}")
    # Apple generates nothing synchronously. Saying "done" here without the wait
    # would send someone to look for reports that cannot exist yet, and conclude
    # the lane failed.
    UI.important("Apple takes roughly a day to produce the first reports. Check back tomorrow.")
    UI.message("Run again with SNAPSHOT=1 to also backfill history.") unless ENV["SNAPSHOT"]
  end

  desc "Pre-submission guard: version state, screenshots, and Guideline 3.1.2 metadata. STRICT=1 to fail."
  # Added after a version was rejected twice for 3.1.2. A description rewrite
  # silently dropped the legal footer AND the auto-renew disclosure, and Apple's
  # automated message named only the EULA link -- so fixing just what the message
  # said would have earned a second rejection. Apps with auto-renewable
  # subscriptions must carry, in the metadata: subscription length, price, and
  # functional links to the privacy policy and Terms of Use.
  lane :asc_check do
    api_key
    app = Spaceship::ConnectAPI::App.find(app_id)
    v = app.get_edit_app_store_version
    UI.user_error!("No editable version to check") if v.nil?
    UI.message("VERSION state=#{v.app_store_state}")

    loc = v.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    if loc
      types = loc.get_app_screenshot_sets.map { |x| "#{x.screenshot_display_type}(#{x.app_screenshots.count})" }
      UI.message("SCREENSHOT SETS: #{types.join(', ')}")
    end

    b = (v.build rescue nil)
    UI.message("BUILD uses_non_exempt_encryption=#{(b&.uses_non_exempt_encryption rescue 'n/a')}")

    # Fail SAFE, not open. If this call throws we must assume subscriptions
    # exist and run the guard anyway: silently skipping the check on an app that
    # does have them is exactly how a 3.1.2 rejection slips through, and a
    # spurious warning costs nothing by comparison.
    subs_exist = begin
      app.get_subscription_groups.any?
    rescue => e
      UI.important("Could not read subscription groups (#{e.class}); assuming they exist.")
      true
    end
    unless subs_exist
      UI.success("No auto-renewing subscriptions — Guideline 3.1.2 does not apply.")
      next
    end

    desc_text = loc ? loc.description.to_s : ""
    missing = []
    missing << "Terms of Use / EULA link" unless desc_text.match?(/eula|terms of use/i) && desc_text.include?("http")
    missing << "privacy policy link"      unless desc_text.match?(%r{https?://\S*privacy}i)
    missing << "'auto-renewing' subscription disclosure" unless desc_text.match?(/auto.?renew/i)
    missing << "billing period (monthly/yearly/weekly)"  unless desc_text.match?(/month|year|week/i)

    if missing.empty?
      UI.success("3.1.2 METADATA: ok (EULA link, privacy link, auto-renew disclosure, billing period all present)")
    else
      UI.error("3.1.2 METADATA MISSING: #{missing.join(' | ')}")
      UI.error("This app has auto-renewable subscriptions, so submitting like this WILL be rejected.")
      UI.user_error!("asc_check failed the Guideline 3.1.2 metadata guard") if ENV["STRICT"]
    end
  end
end
